[Unit]
Description=Install default Flatpaks
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/flatpaks.done

[Service]
Type=oneshot
ExecStart=/bin/sh -c '\
  /usr/bin/flatpak remote-add --if-not-exists --system flathub https://dl.flathub.org/repo/flathub.flatpakrepo && \
  /usr/bin/flatpak install -y --system flathub md.obsidian.Obsidian && \
  /usr/bin/touch /var/lib/flatpaks.done'
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
